package views

import (
    "ServidorTrabajoWeb/db/sqlc"
)

templ Index(recetas []db.ListRecetaRow) {
	@Layout("Página de Recetas") {
		<hgroup>
			<h1>Página de Recetas</h1>
			<p>Gestión de recetas con Server-Side Rendering en Go y Templ</p>
		</hgroup>
		
		@RecetaForm()
		@RecetaList(recetas)
	}
}