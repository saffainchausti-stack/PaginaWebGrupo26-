package views

import (
    "ServidorTrabajoWeb/db/sqlc"
)

templ MyRecetas(recetas []db.ListRecetaByUsuarioRow) {
	@Layout("Página de Recetas") {
		<hgroup>
			<h1>Página de Mis Recetas</h1>
			<p>Gestión de recetas con Server-Side Rendering en Go y Templ</p>
		</hgroup>
		
		@RecetaForm()
		@RecetaByIdUsuarioList(recetas)
	}
}